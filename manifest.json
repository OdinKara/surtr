{
  "manifest_version": 3,
  "name": "Surtr",
  "version": "1.0.0",
  "description": "Bulk X post removal. Runs entirely in your browser. Nothing is uploaded.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["content/executor.js"], "run_at": "document_idle" }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Surtr",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": { "default_path": "ui/panel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://x.com"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["https://x.com/*"],
      "use_dynamic_url": true
    }
  ]
}
