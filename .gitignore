# Dependencies / build output. Surtr has NO build step; these exist so that a
# stray tool run can never sneak generated or packaged artifacts into a repo
# whose entire security argument is "the shipped code IS the repo code".
node_modules/
dist/
*.zip
*.crx

# Signing material. A .pem here would be a private key.
*.pem

# Secrets and local-only config.
.env
*.local.json

# Runtime output.
logs/

# Scan output. These contain YOUR post text, ids and permalinks - personal data
# by definition. They are written to your Downloads folder by design; this rule
# exists in case one is ever moved into the tree.
surtr-report-*.json
surtr-report-*.csv

# Kill logs. THE MOST SENSITIVE FILE THIS TOOL PRODUCES: the full text, ids and
# permalinks of posts that no longer exist anywhere else. It is the only record
# of what was destroyed, which is exactly why it must never become a commit.
surtr-killlog-*.json
surtr-killlog-*.csv

# Captured API responses. Kept out of the tree on purpose - a single X GraphQL
# response body carries the account's numeric user id and the full text of
# posts, including other people's. Read a capture in place; never copy one in.
*-response.json
*-capture.json
surtr-capture-*.json
